# Backend + Infra — Entorn PRODUCCIÓ (template)
# Copia a .env.production al servidor i omple els secrets reals.
# MAI commitegis .env.production amb secrets reals.

# --- Domini ---
APP_DOMAIN=amgdl.com
SERVER_IP=65.108.148.62

# --- Base de dades ---
DATASOURCE_URL=jdbc:postgresql://amg-postgres:5432/amg_platform
DATASOURCE_USERNAME=amg
DATASOURCE_PASSWORD=CANVIA_PER_PASSWORD_SEGUR

# --- Redis ---
REDIS_HOST=amg-redis
REDIS_PORT=6379
REDIS_PASSWORD=CANVIA_PER_PASSWORD_SEGUR

# --- MinIO (assets) ---
MINIO_ENDPOINT=http://amg-minio:9000
MINIO_ROOT_USER=amg_admin
MINIO_ROOT_PASSWORD=CANVIA_PER_PASSWORD_SEGUR
MINIO_BUCKET=amg-assets

# --- JWT (genera amb: openssl rand -base64 64) ---
JWT_SECRET=GENERA_AMB_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Jasypt (xifrat de credencials al Vault) ---
JASYPT_ENCRYPTOR_PASSWORD=CANVIA_PER_PASSPHRASE_SEGUR

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=https://amgdl.com,https://www.amgdl.com

# --- Proveïdors ---
FINOP_PROVIDER=mock
PAYMENTS_PROVIDER=mock
BACKUP_PROVIDER=mock
GOCARDLESS_PROVIDER=mock
PROSPECTING_PROVIDER=mock
AUTOMATIONS_PROVIDER=mock

# --- Agents IA ---
ANTHROPIC_API_KEY=
AGENTS_CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Notificacions Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email agent ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=agent@amgdl.com

# --- Stripe (quan s'activi) ---
STRIPE_API_KEY=

# --- Google Places (prospecció) ---
GOOGLE_PLACES_API_KEY=

# --- Traefik dashboard (genera amb: htpasswd -nb admin PASSWORD) ---
TRAEFIK_AUTH=admin:$$apr1$$HASH_AQUI
ACME_EMAIL=hola@amgdl.com
