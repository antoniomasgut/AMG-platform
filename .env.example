# =============================================================
# AMG Platform — Variables d'entorn
# Copia aquest fitxer a .env i omple els valors
# MAI commitegis .env al repositori
# =============================================================

# --- Dominis ---
APP_DOMAIN=amg.example.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=amg_platform
POSTGRES_USER=amg
POSTGRES_PASSWORD=canvia_aquesta_contrasenya

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=canvia_aquesta_contrasenya

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=amg_admin
MINIO_ROOT_PASSWORD=canvia_aquesta_contrasenya
MINIO_BUCKET=amg-assets

# --- JWT ---
JWT_SECRET=genera_un_secret_de_64_chars_minim_aqui
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Jasypt (xifrat AES-256 credencials clients) ---
JASYPT_ENCRYPTOR_PASSWORD=genera_un_secret_fort_aqui

# --- Backend Spring Boot ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Google Cloud Storage (Backup) ---
# BACKUP_PROVIDER=gcs
# GCS_BUCKET_NAME=amg-backups
# GCS_PROJECT_ID=your-gcp-project-id

# --- Google Places (Prospecting) ---
# PROSPECTING_PROVIDER=google-places
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- Stripe (Payments) ---
STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Holded (FinOps) ---
HOLDED_API_KEY=
# HOLDED_WEBHOOK_SECRET=

# --- n8n (Automations) ---
# AUTOMATIONS_PROVIDER=n8n
# N8N_API_URL=http://n8n:5678/api/v1
# N8N_API_KEY=your-n8n-api-key
# N8N_DB_PASSWORD=genera_una_contrasenya_per_n8n

# --- Traefik (proxy invers) ---
# TRAEFIK_AUTH=$(htpasswd -nb admin tu-contrasenya)

# --- Sentry (error monitoring) ---
# SENTRY_DSN=https://public@sentry.example.com/1
# SENTRY_ORG=amg-digitalitzacio
# SENTRY_PROJECT=amg-portal
# NEXT_PUBLIC_SENTRY_DSN=https://public@sentry.example.com/1

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=https://api.${APP_DOMAIN}
NODE_ENV=production
