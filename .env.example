# =============================================================
# AMG Platform — Variables d'entorn
# Copia aquest fitxer a .env i omple els valors
# MAI commitegis .env al repositori
# =============================================================

# --- Dominis ---
APP_DOMAIN=amg.example.com
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=amg_platform
POSTGRES_USER=amg
POSTGRES_PASSWORD=canvia_aquesta_contrasenya

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=canvia_aquesta_contrasenya

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=amg_admin
MINIO_ROOT_PASSWORD=canvia_aquesta_contrasenya
MINIO_BUCKET=amg-assets

# --- JWT ---
JWT_SECRET=genera_un_secret_de_64_chars_minim_aqui
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Jasypt (xifrat AES-256 credencials clients) ---
JASYPT_ENCRYPTOR_PASSWORD=genera_un_secret_fort_aqui

# --- Backend Spring Boot ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- Frontend Next.js ---
NEXT_PUBLIC_API_URL=https://api.${APP_DOMAIN}
NODE_ENV=production
