# Backend + Infra — Entorn LOCAL DEV
# Carrega amb: export $(grep -v '^#' .env.dev | xargs)
# Mai commitegis secrets reals aquí.

# --- Base de dades ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/amg_platform
DATASOURCE_USERNAME=amg
DATASOURCE_PASSWORD=amg_dev_secret

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_secret

# --- MinIO (assets) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=amg_admin
MINIO_ROOT_PASSWORD=minio_dev_secret
MINIO_BUCKET=amg-assets
STORAGE_PATH=/tmp/amg-assets

# --- JWT ---
JWT_SECRET=dev-jwt-secret-canvia-en-produccio-min-64-chars-per-hmac-sha256-ok!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- CORS ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Proveïdors (tots en mode mock per a dev) ---
FINOP_PROVIDER=mock
PAYMENTS_PROVIDER=mock
BACKUP_PROVIDER=mock
GOCARDLESS_PROVIDER=mock
PROSPECTING_PROVIDER=mock
AUTOMATIONS_PROVIDER=mock

# --- Agents IA ---
ANTHROPIC_API_KEY=
AGENTS_DEFAULT_MODEL=deepseek-chat

# --- Notificacions internes (Telegram intern d'AMG) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Agents: Telegram (bot de cara al client) ---
AGENTS_TELEGRAM_BOT_TOKEN=

# --- Agents: WhatsApp Twilio ---
AGENTS_WHATSAPP_TWILIO_ACCOUNT_SID=
AGENTS_WHATSAPP_TWILIO_AUTH_TOKEN=

# --- Agents: WhatsApp Meta (directe) ---
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_VERIFY_TOKEN=amg_meta_verify_dev

# --- Email agent ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=agent@amgdl.com

# --- DeepSeek ---
DEEPSEEK_API_KEY=
